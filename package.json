{
  "name": "kubeshield",
  "version": "0.1.0",
  "private": true,
  "description": "Kubernetes runtime security platform",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "sim": "npm run start -w @kubeshield/simulator --",
    "db:migrate": "npm run start -w @kubeshield/migrate",
    "db:count": "npm run count -w @kubeshield/migrate",
    "test:unit": "KS_UNIT_ONLY=1 vitest run --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\"",
    "env:init": "bash scripts/init-env.sh",
    "e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
