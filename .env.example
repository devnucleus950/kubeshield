# Copy this file to .env (which is git-ignored) and fill in the secrets.
# Generate the API key with:  openssl rand -hex 32
# Use 127.0.0.1, not localhost, in every URL.

NODE_ENV=development
LOG_LEVEL=info

# Ingest API
INGEST_PORT=4000
INGEST_API_KEY=replace-with-output-of-openssl-rand-hex-32
STREAM_MAXLEN=100000

# Redis (host port 6379)
REDIS_URL=redis://127.0.0.1:6379

# Postgres (host port 5433; inside Docker it is still 5432)
POSTGRES_USER=kubeshield
POSTGRES_PASSWORD=replace-with-a-password-you-choose
POSTGRES_DB=kubeshield
DATABASE_URL=postgres://kubeshield:replace-with-a-password-you-choose@127.0.0.1:5433/kubeshield

# Worker
WORKER_BATCH_SIZE=50
WORKER_MAX_DELIVERIES=5
